{
    "name": "frappe-node-api",
    "version": "1.0.0",
    "description": "Lightweight Express proxy server for Frappe API",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "prod": "pm2 start ecosystem.config.cjs",
        "prod:stop": "pm2 stop ecosystem.config.cjs",
        "prod:restart": "pm2 restart ecosystem.config.cjs",
        "prod:delete": "pm2 delete ecosystem.config.cjs"
    },
    "keywords": [
        "frappe",
        "proxy",
        "express"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "http-proxy-middleware": "^2.0.6",
        "pm2": "^5.3.0"
    }
}
